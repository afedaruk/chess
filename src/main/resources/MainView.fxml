<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.HBox ?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.MainController"
      prefWidth="800"
      prefHeight="1000">
    <GridPane fx:id="boardGrid" gridLinesVisible="true"/>
    <HBox fx:id="promotionChoiceContainer">
        <padding>
            <Insets left="200" right="200"/>
        </padding>
    </HBox>
    <CheckBox fx:id="checkBox" text="Flip the board" onAction="#handleButtonClick"/>
    <Button fx:id="restartButton" text="Restart" onAction="#initialize"/>
</VBox>